rules_version = '2';
// Red Pen: one document per user, users/{uid} = { state: JSON string, schema: int, updatedAt: server time }.
// Only the signed-in owner can read or write it. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validState() {
        let d = request.resource.data;
        return d.keys().hasOnly(['state', 'schema', 'updatedAt'])
          && d.keys().hasAll(['state', 'schema', 'updatedAt'])
          && d.state is string
          && d.state.size() < 800000          // the whole document must stay under Firestore's 1 MiB
          && d.schema is int && d.schema >= 2 && d.schema < 100
          && d.updatedAt == request.time;     // must be serverTimestamp()
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validState();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
